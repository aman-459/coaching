<% layout('layouts/boilerplate') -%>

<div class="mb-6">
  <h1 class="text-2xl font-bold text-slate-800">Attendance Register</h1>
  <p class="text-sm text-slate-500">Mark and update daily student attendance</p>
</div>

<!-- Filter Bar: Batch & Date Picker -->
<form method="GET" action="/attendance" class="bg-white p-4 rounded-xl border border-slate-100 shadow-sm mb-6 flex flex-wrap gap-4 items-end">
  <div class="w-full sm:w-64">
    <label class="block text-xs font-semibold text-slate-500 uppercase mb-1">Select Batch</label>
    <select name="batchId" class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500" onchange="this.form.submit()">
      <% batches.forEach(b => { %>
        <option value="<%= b._id %>" <%= selectedBatch && selectedBatch._id.toString() === b._id.toString() ? 'selected' : '' %>>
          <%= b.name %> (<%= b.subject %>)
        </option>
      <% }) %>
    </select>
  </div>

  <div class="w-full sm:w-48">
    <label class="block text-xs font-semibold text-slate-500 uppercase mb-1">Date</label>
    <input type="date" name="date" value="<%= selectedDate %>" class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" onchange="this.form.submit()">
  </div>
</form>

<!-- Attendance Sheet Table -->
<% if (selectedBatch) { %>
  <div class="bg-white rounded-xl shadow-sm border border-slate-100 overflow-hidden">
    <form action="/attendance/save" method="POST">
      <input type="hidden" name="batchId" value="<%= selectedBatch._id %>">
      <input type="hidden" name="date" value="<%= selectedDate %>">

      <div class="p-4 bg-slate-50 border-b border-slate-200 flex justify-between items-center">
        <span class="text-sm font-semibold text-slate-700">
          <%= selectedBatch.name %> • <%= selectedBatch.students.length %> Enrolled
        </span>
        <button type="submit" class="bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-medium px-4 py-1.5 rounded-lg transition shadow-sm">
          Save Attendance
        </button>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm text-slate-600">
          <thead class="bg-slate-50 text-slate-700 uppercase font-semibold text-xs border-b border-slate-200">
            <tr>
              <th class="px-6 py-3">Student Name</th>
              <th class="px-6 py-3">Phone</th>
              <th class="px-6 py-3 text-center">Status</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% if (selectedBatch.students.length === 0) { %>
              <tr>
                <td colspan="3" class="px-6 py-8 text-center text-slate-400">
                  Is batch me koi student nahi hai. Pehle student enroll karein.
                </td>
              </tr>
            <% } %>

            <% selectedBatch.students.forEach((s) => { %>
              <% const isPresent = attendanceMap[s._id.toString()] !== 'Absent'; %>
              <tr class="hover:bg-slate-50/50">
                <td class="px-6 py-4 font-medium text-slate-800"><%= s.name %></td>
                <td class="px-6 py-4"><%= s.phone %></td>
                <td class="px-6 py-4 text-center">
                  <div class="inline-flex gap-4">
                    <label class="inline-flex items-center gap-1 cursor-pointer text-emerald-700 font-medium">
                      <input type="radio" name="attendance[<%= s._id %>]" value="Present" <%= isPresent ? 'checked' : '' %> class="text-emerald-600 focus:ring-emerald-500">
                      Present
                    </label>
                    <label class="inline-flex items-center gap-1 cursor-pointer text-rose-700 font-medium">
                      <input type="radio" name="attendance[<%= s._id %>]" value="Absent" <%= !isPresent ? 'checked' : '' %> class="text-rose-600 focus:ring-rose-500">
                      Absent
                    </label>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </form>
  </div>
<% } else { %>
  <div class="bg-white p-8 rounded-xl border border-slate-200 text-center text-slate-500">
    Pehle ek batch create karein attendance mark karne ke liye.
  </div>
<% } %>