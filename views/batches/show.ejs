<% layout('layouts/boilerplate') -%>
<div class="mb-6"><a href="/batches" class="text-sm font-medium text-indigo-600 hover:text-indigo-800">← Back to Batches</a></div>

<div class="bg-white p-6 rounded-xl border border-slate-100 shadow-sm mb-8 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
  <div>
    <h1 class="text-2xl font-bold text-slate-900"><%= batch.name %></h1>
    <p class="text-slate-500 text-sm mt-1">Subject: <span class="font-medium text-slate-700"><%= batch.subject %></span> • Timing: <span class="font-medium text-slate-700"><%= batch.schedule || 'N/A' %></span></p>
  </div>
  <div class="flex items-center gap-4">
    <div class="text-right">
      <div class="text-xs uppercase text-slate-400 font-semibold">Monthly Fee</div>
      <div class="text-2xl font-extrabold text-slate-800">₹<%= batch.monthlyFee %></div>
    </div>
    <div class="flex items-center gap-2 border-l border-slate-200 pl-4">
      <a href="/batches/<%= batch._id %>/edit" class="text-xs px-3 py-2 border border-slate-300 rounded-lg text-slate-700 hover:bg-slate-50">Edit</a>
      <form action="/batches/<%= batch._id %>?_method=DELETE" method="POST" onsubmit="return confirm('Delete this batch?');">
        <button type="submit" class="text-xs px-3 py-2 bg-rose-50 text-rose-600 border border-rose-200 rounded-lg hover:bg-rose-100">Delete</button>
      </form>
    </div>
  </div>
</div>

<div class="flex justify-between items-center mb-4">
  <h2 class="text-lg font-bold text-slate-800">Enrolled Students (<%= batch.students.length %>)</h2>
  <a href="/students/new" class="text-sm bg-indigo-600 hover:bg-indigo-700 text-white px-3 py-1.5 rounded-lg font-medium transition">+ Add Student</a>
</div>

<div class="bg-white rounded-xl shadow-sm border border-slate-100 divide-y divide-slate-100">
  <% if (batch.students.length === 0) { %>
    <div class="p-6 text-center text-slate-400 text-sm">No students enrolled in this batch yet.</div>
  <% } %>
  <% batch.students.forEach(student => { %>
    <div class="p-4 flex items-center justify-between">
      <div>
        <div class="font-semibold text-slate-800"><%= student.name %></div>
        <div class="text-xs text-slate-500">Phone: <%= student.phone %></div>
      </div>
      <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium <%= student.feesStatus === 'Paid' ? 'bg-emerald-100 text-emerald-800' : 'bg-amber-100 text-amber-800' %>"><%= student.feesStatus %></span>
    </div>
  <% }) %>
</div>