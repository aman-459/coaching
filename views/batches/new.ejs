<% layout('layouts/boilerplate') -%>
<div class="max-w-xl mx-auto bg-white p-8 rounded-xl shadow-sm border border-slate-100">
  <h1 class="text-xl font-bold text-slate-800 mb-6">Create New Batch</h1>
  <form action="/batches" method="POST" class="space-y-4">
    <div>
      <label class="block text-sm font-medium text-slate-700 mb-1">Batch Name</label>
      <input type="text" name="name" required placeholder="e.g. Class 10 Board Prep" class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
    </div>
    <div>
      <label class="block text-sm font-medium text-slate-700 mb-1">Subject</label>
      <input type="text" name="subject" required placeholder="e.g. Mathematics" class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
    </div>
    <div>
      <label class="block text-sm font-medium text-slate-700 mb-1">Schedule / Timings</label>
      <input type="text" name="schedule" placeholder="e.g. Mon, Wed, Fri - 5:00 PM" class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
    </div>
    <div>
      <label class="block text-sm font-medium text-slate-700 mb-1">Monthly Fee (₹)</label>
      <input type="number" name="monthlyFee" required placeholder="1500" class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
    </div>
    <div class="flex justify-end gap-3 pt-4">
      <a href="/batches" class="px-4 py-2 border border-slate-300 rounded-lg text-sm text-slate-600 hover:bg-slate-50">Cancel</a>
      <button type="submit" class="px-5 py-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg text-sm font-medium shadow-sm transition">Save Batch</button>
    </div>
  </form>
</div>