<% layout('layouts/boilerplate') -%>
<div class="max-w-xl mx-auto bg-white p-8 rounded-xl shadow-sm border border-slate-100">
  <h1 class="text-xl font-bold text-slate-800 mb-6">Edit Batch Details</h1>
  <form action="/batches/<%= batch._id %>?_method=PUT" method="POST" class="space-y-4">
    <div>
      <label class="block text-sm font-medium text-slate-700 mb-1">Batch Name</label>
      <input type="text" name="name" value="<%= batch.name %>" required class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
    </div>
    <div>
      <label class="block text-sm font-medium text-slate-700 mb-1">Subject</label>
      <input type="text" name="subject" value="<%= batch.subject %>" required class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
    </div>
    <div>
      <label class="block text-sm font-medium text-slate-700 mb-1">Schedule / Timings</label>
      <input type="text" name="schedule" value="<%= batch.schedule || '' %>" class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
    </div>
    <div>
      <label class="block text-sm font-medium text-slate-700 mb-1">Monthly Fee (₹)</label>
      <input type="number" name="monthlyFee" value="<%= batch.monthlyFee %>" required class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
    </div>
    <div class="flex justify-end gap-3 pt-4">
      <a href="/batches/<%= batch._id %>" class="px-4 py-2 border border-slate-300 rounded-lg text-sm text-slate-600 hover:bg-slate-50">Cancel</a>
      <button type="submit" class="px-5 py-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg text-sm font-medium shadow-sm transition">Update Batch</button>
    </div>
  </form>
</div>